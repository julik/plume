#!/usr/bin/env ruby
# frozen_string_literal: true

# Prints how much of the fixture corpus parses, bucketed by the leading keyword.
# With --write, also records the passing fixtures in fixtures/passing.txt (which
# test/fixtures.test.rb holds us to) and the table in llm/fixture-report.txt

require "bundler/setup"
require "plume"
require_relative "../test/support/fixture_corpus"

counts = Hash.new { |h, k| h[k] = Hash.new(0) }
passing = []

FixtureCorpus.paths.each do |path|
	status = FixtureCorpus.classify(path)
	counts[FixtureCorpus.leading_keyword(path)][status] += 1
	passing << path if status == :pass
end

rows = counts.sort_by { |kw, c| [-c.values.sum, kw.to_s] }.map do |kw, c|
	format("%-12s %7d %7d %7d %7d", kw, c.values.sum, c[:pass], c[:fail], c[:not_implemented])
end
totals = counts.values.each_with_object(Hash.new(0)) { |c, t| c.each { |k, v| t[k] += v } }

report = [
	format("%-12s %7s %7s %7s %7s", "KEYWORD", "TOTAL", "PASS", "FAIL", "NYI"),
	*rows,
	format("%-12s %7d %7d %7d %7d", "ALL", totals.values.sum, totals[:pass], totals[:fail], totals[:not_implemented]),
].join("\n") + "\n"

puts report

if ARGV.include?("--write")
	root = FixtureCorpus::ROOT
	File.write(FixtureCorpus::BASELINE_PATH, passing.join("\n") + "\n")
	File.write(File.join(root, "llm/fixture-report.txt"), report)

	lost = FixtureCorpus.baseline - passing
	warn "#{lost.size} fixtures that used to pass no longer do" if lost.any?
end
